{
  "name": "vps-monitor",
  "productName": "VPS Monitor",
  "version": "1.0.0",
  "description": "Ping monitor and power control for VPS and PCs",
  "author": "VPS Monitor",
  "type": "module",
  "private": true,
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "dist": "electron-builder --win nsis",
    "test": "node --test"
  },
  "build": {
    "appId": "com.vpsmonitor.app",
    "productName": "VPS Monitor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "server.js",
      "package.json",
      "lib/**",
      "public/**",
      "electron/**",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VPS Monitor",
      "artifactName": "VPS-Monitor-Setup.exe"
    }
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  }
}
